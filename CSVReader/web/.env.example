# Neon database provisioned through the Vercel Marketplace
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# Google Cloud Console OAuth 2.0 web client
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

# Comma-separated accounts. Admins can view the access audit.
ADMIN_EMAILS=owner@example.com
ALLOWED_EMAILS=subordinate@example.com

# Vercel automatically sends this to the cron route as a bearer token.
CRON_SECRET=replace-with-a-random-secret

GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1-crbMCbGgsHydSUQzhVpWHwS7wRniHt8TN9z-7XQ8Pk/gviz/tq?tqx=out:csv&gid=0
GOOGLE_RAW_CSV_URL=https://docs.google.com/spreadsheets/d/13FkrRLKS1HBhIYQtQTEyZ-QD4pa0_169VUTx5HGY8F0/gviz/tq?tqx=out:csv&gid=2124284441
STATION_CODE=C4-NIL-5-85
APP_TIME_ZONE=Asia/Kuala_Lumpur
